pipeline {

    agent {
        docker {
            image 'hashicorp/terraform:1.7.0'
        }
    }

    options {
        // Prevent two Terraform operations from running against the same state
        disableConcurrentBuilds()

        // Add timestamps to Jenkins logs
        timestamps()

        // Prevent a stuck pipeline from running forever
        timeout(time: 45, unit: 'MINUTES')

        // We explicitly checkout SCM ourselves
        skipDefaultCheckout(true)
    }

    parameters {
        choice(
            name: 'ACTION',
            choices: ['APPLY', 'DESTROY'],
            description: 'Choose whether Terraform should apply changes or destroy the infrastructure.'
        )

        string(
            name: 'DESTROY_CONFIRM',
            defaultValue: '',
            description: 'Required only for DESTROY. Type DESTROY exactly.'
        )
    }

    environment {
        TF_IN_AUTOMATION = 'true'

        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
    }

    stages {

        stage('Checkout') {
            steps {
                cleanWs()

                checkout scm
            }
        }

        stage('Validate Parameters') {
            steps {
                script {
                    if (params.ACTION == 'DESTROY' &&
                        params.DESTROY_CONFIRM != 'DESTROY') {

                        error(
                            'DESTROY selected, but DESTROY_CONFIRM is not exactly "DESTROY".'
                        )
                    }
                }
            }
        }

        stage('Terraform Lint & Validate') {
            steps {

                // Check formatting recursively
                sh '''
                    terraform fmt -check -recursive
                '''

                // Validate Terraform configuration without contacting backend
                sh '''
                    terraform init \
                        -backend=false \
                        -input=false
                '''

                sh '''
                    terraform validate
                '''
            }
        }

        stage('Terraform Init') {
            steps {

                sh '''
                    terraform init \
                        -input=false \
                        -lock-timeout=5m
                '''
            }
        }

        stage('Terraform Plan') {
            steps {

                script {

                    if (params.ACTION == 'DESTROY') {

                        echo 'Generating DESTROY plan...'

                        sh '''
                            terraform plan \
                                -destroy \
                                -input=false \
                                -lock-timeout=5m \
                                -out=tfplan
                        '''

                    } else {

                        echo 'Generating APPLY plan...'

                        sh '''
                            terraform plan \
                                -input=false \
                                -lock-timeout=5m \
                                -out=tfplan
                        '''
                    }
                }

                // Show exactly what is stored in tfplan
                sh '''
                    terraform show -no-color tfplan
                '''

                // Preserve exact plan for execution
                stash(
                    name: 'terraform-plan',
                    includes: 'tfplan',
                    useDefaultExcludes: false
                )
            }
        }

        stage('Manual Approval Gate') {

            // Don't occupy a Jenkins executor while waiting
            agent none

            options {
                timeout(time: 15, unit: 'MINUTES')
            }

            steps {
                script {

                    def operation = params.ACTION == 'DESTROY'
                        ? 'DESTROY infrastructure'
                        : 'APPLY infrastructure changes'

                    input(
                        message: "The Terraform plan has been generated. Proceed with ${operation}?",
                        ok: params.ACTION == 'DESTROY'
                            ? 'DESTROY'
                            : 'APPLY CHANGES'
                    )
                }
            }
        }

        stage('Terraform Execute') {

            steps {

                // Workspace may have changed after agent none,
                // so restore the source and exact saved plan.
                cleanWs()

                checkout scm

                // Providers must exist before applying a saved plan.
                sh '''
                    terraform init \
                        -input=false \
                        -lock-timeout=5m
                '''

                unstash 'terraform-plan'

                echo "Executing Terraform ${params.ACTION}..."

                // Important:
                // The exact saved plan is executed.
                // For a destroy plan, this performs the destroy.
                sh '''
                    terraform apply \
                        -input=false \
                        tfplan
                '''
            }
        }
    }

    post {

        always {
            cleanWs()
        }

        success {
            echo "Terraform ${params.ACTION} completed successfully."
        }

        failure {
            echo "Terraform pipeline failed. Review the Jenkins logs."
        }
    }
}