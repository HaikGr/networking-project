pipeline {

    agent any

    
    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
        skipDefaultCheckout(true)
    }

    parameters {
        choice(
            name: 'ACTION',
            choices: ['APPLY', 'DESTROY'],
            description: 'Choose Terraform operation.'
        )

        string(
            name: 'DESTROY_CONFIRM',
            defaultValue: '',
            description: 'For DESTROY, type DESTROY exactly.'
        )
    }

    environment {
        TF_IN_AUTOMATION = 'true'

        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
    }


    stages {

        stage('Checkout') {
            steps {
                cleanWs()
                checkout scm
            }
        }

        stage('Terraform fmt -check') {
            steps {
                sh 'terraform fmt -check -recursive'
            }
        }

        stage('Terraform validate') {
            steps {

                sh '''
                    terraform init \
                        -backend=false \
                        -input=false
                '''

                sh 'terraform validate'
            }
        }

        stage('Terraform plan') {
            steps {

                script {

                    if (params.ACTION == 'DESTROY' &&
                        params.DESTROY_CONFIRM != 'DESTROY') {

                        error(
                            'DESTROY selected, but DESTROY_CONFIRM is not exactly DESTROY.'
                        )
                    }
                }

                sh '''
                    terraform init \
                        -input=false \
                        -lock-timeout=5m
                '''

                script {

                    if (params.ACTION == 'DESTROY') {

                        echo 'Generating DESTROY plan...'

                        sh '''
                            terraform plan \
                                -destroy \
                                -input=false \
                                -lock-timeout=5m \
                                -out=tfplan
                        '''

                    } else {

                        echo 'Generating APPLY plan...'

                        sh '''
                            terraform plan \
                                -input=false \
                                -lock-timeout=5m \
                                -out=tfplan
                        '''
                    }
                }

                sh '''
                    terraform show \
                        -no-color \
                        tfplan > tfplan.txt
                '''

                sh 'cat tfplan.txt'

                archiveArtifacts(
                    artifacts: 'tfplan,tfplan.txt',
                    fingerprint: true
                )

                stash(
                    name: 'terraform-plan',
                    includes: 'tfplan'
                )
            }
        }

        stage('Manual Approval') {

            agent none

            options {
                timeout(time: 15, unit: 'MINUTES')
            }

            steps {

                script {

                    def operation =
                        params.ACTION == 'DESTROY'
                        ? 'DESTROY the infrastructure'
                        : 'APPLY the infrastructure changes'

                    input(
                        message: "Read the Terraform plan above. Do you want to ${operation}?",
                        ok: params.ACTION == 'DESTROY'
                            ? 'DESTROY'
                            : 'APPLY CHANGES'
                    )
                }
            }
        }

        stage('Terraform apply saved plan') {
            steps {

                cleanWs()

                checkout scm

                sh '''
                    terraform init \
                        -input=false \
                        -lock-timeout=5m
                '''

                unstash 'terraform-plan'

                sh '''
                    terraform apply \
                        -input=false \
                        tfplan
                '''
            }
        }
    }

    post {

        always {
            cleanWs()
        }

        success {
            echo "Terraform ${params.ACTION} completed successfully."
        }

        failure {
            echo "Terraform pipeline failed."
        }
    }
}